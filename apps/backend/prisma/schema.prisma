generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  agent
  admin
}

enum TicketPriority {
  low
  medium
  high
}

enum TicketStatus {
  open
  in_progress
  resolved
}

enum TicketActivityType {
  status_change
  assignment_change
  assignment_request
  ticket_update
}

enum IssueType {
  hardware
  software
  network
  access
  other
}

enum AttributeType {
  text
  number
  select
  multiselect
  date
  boolean
}

enum WorkflowStepAction {
  create
  update
  assign
  resolve
  escalate
  comment
}

model User {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  passwordHash String
  role         Role           @default(user)
  tickets      Ticket[]       @relation("TicketCreator")
  assignments  Ticket[]       @relation("TicketAssignee")
  assignmentRequests Ticket[] @relation("TicketAssignmentRequests")
  activityEntries    TicketActivity[] @relation("TicketActivityActor")
  activityFromAssignments TicketActivity[] @relation("TicketActivityFromAssignee")
  activityToAssignments   TicketActivity[] @relation("TicketActivityToAssignee")
  devices      DeviceToken[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  aiSuggestions AiSuggestion[]
}

model Ticket {
  id          String        @id @default(uuid())
  createdBy   String
  creator     User          @relation("TicketCreator", fields: [createdBy], references: [id])
  assignedTo  String?
  assignee    User?         @relation("TicketAssignee", fields: [assignedTo], references: [id])
  priority    TicketPriority @default(medium)
  issueType   IssueType      @default(other)
  status      TicketStatus   @default(open)
  description String
  attachments String[]
  assignmentRequestId String?
  assignmentRequest   User?    @relation("TicketAssignmentRequests", fields: [assignmentRequestId], references: [id])
  categoryId  String?
  category    TicketCategory? @relation(fields: [categoryId], references: [id])
  subcategoryId String?
  subcategory TicketSubcategory? @relation(fields: [subcategoryId], references: [id])
  workflowId  String?
  workflow    WorkflowDefinition? @relation(fields: [workflowId], references: [id])
  currentStepId String?
  currentStep WorkflowStep? @relation("TicketCurrentStep", fields: [currentStepId], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  resolvedAt  DateTime?
  activities  TicketActivity[]
  aiSuggestions AiSuggestion[]
  attributeValues TicketAttributeValue[]
  workflowSteps TicketWorkflowStep[]

  @@index([categoryId])
  @@index([subcategoryId])
  @@index([workflowId])
}

model AiSuggestion {
  id           String   @id @default(uuid())
  ticketId     String?
  ticket       Ticket?  @relation(fields: [ticketId], references: [id])
  suggestionType String
  prompt       String
  result       Json
  provider     String?
  providerMeta Json?
  createdBy    String?
  createdByUser User?   @relation(fields: [createdBy], references: [id])
  createdAt    DateTime @default(now())

  @@index([ticketId])
}

model TicketActivity {
  id              String              @id @default(uuid())
  ticketId        String
  ticket          Ticket              @relation(fields: [ticketId], references: [id])
  actorId         String
  actor           User                @relation("TicketActivityActor", fields: [actorId], references: [id])
  type            TicketActivityType
  fromStatus      TicketStatus?
  toStatus        TicketStatus?
  fromAssigneeId  String?
  fromAssignee    User?               @relation("TicketActivityFromAssignee", fields: [fromAssigneeId], references: [id])
  toAssigneeId    String?
  toAssignee      User?               @relation("TicketActivityToAssignee", fields: [toAssigneeId], references: [id])
  createdAt       DateTime            @default(now())

  @@index([ticketId])
}

model DeviceToken {
  id          String   @id @default(uuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  deviceToken String
  platform    String
  updatedAt   DateTime  @updatedAt

  @@unique([userId, deviceToken])
}

model TicketCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tickets     Ticket[]
  subcategories TicketSubcategory[]
  workflows   WorkflowDefinition[]
  slas        TicketSLA[]
}

model TicketSubcategory {
  id          String   @id @default(uuid())
  name        String
  description String?
  categoryId  String
  category    TicketCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tickets     Ticket[]
  slas        TicketSLA[]

  @@unique([categoryId, name])
  @@index([categoryId])
}

model TicketSLA {
  id                   String   @id @default(uuid())
  name                 String   @unique
  description          String?
  categoryId           String
  category             TicketCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategoryId        String?
  subcategory          TicketSubcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  priority             TicketPriority
  responseTimeMinutes  Int
  resolutionTimeMinutes Int
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([categoryId, subcategoryId, priority])
  @@index([categoryId])
  @@index([subcategoryId])
}

model TicketAttribute {
  id          String   @id @default(uuid())
  name        String   @unique
  label       String
  type        AttributeType
  mandatory   Boolean  @default(false)
  visible     Boolean  @default(true)
  options     Json?    // For select/multiselect types
  defaultValue String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  values      TicketAttributeValue[]
}

model TicketAttributeValue {
  id          String   @id @default(uuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  attributeId String
  attribute   TicketAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([ticketId, attributeId])
  @@index([ticketId])
  @@index([attributeId])
}

model WorkflowDefinition {
  id          String   @id @default(uuid())
  name        String
  description String?
  categoryId  String?
  category    TicketCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  version     Int      @default(1)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  steps       WorkflowStep[]
  tickets     Ticket[]

  @@unique([categoryId, version])
  @@index([categoryId])
}

model WorkflowStep {
  id          String   @id @default(uuid())
  workflowId  String
  workflow    WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  name        String
  description String?
  order       Int
  initiatorRole Role?  // null means any role can perform this step
  allowedActions Json   // Array of WorkflowStepAction
  conditions  Json?    // Conditions for step transition
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ticketsAtStep Ticket[] @relation("TicketCurrentStep")
  ticketSteps TicketWorkflowStep[]

  @@unique([workflowId, order])
  @@index([workflowId])
}

model TicketWorkflowStep {
  id          String   @id @default(uuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  stepId      String
  step        WorkflowStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  enteredAt   DateTime @default(now())
  exitedAt    DateTime?
  actorId     String?
  notes       String?

  @@index([ticketId])
  @@index([stepId])
}
