generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  agent
  admin
}

enum TicketPriority {
  low
  medium
  high
}

enum TicketStatus {
  open
  in_progress
  resolved
}

enum TicketActivityType {
  status_change
  assignment_change
  assignment_request
  ticket_update
  comment
  reply
  step_completed
}

enum IssueType {
  hardware
  software
  network
  access
  other
}

// Dynamic attribute support
enum AttributeType {
  text
  number
  date
  select
  multiselect
  file
}

model User {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  passwordHash String
  role         Role           @default(user)
  tickets      Ticket[]       @relation("TicketCreator")
  assignments  Ticket[]       @relation("TicketAssignee")
  assignmentRequests Ticket[] @relation("TicketAssignmentRequests")
  activityEntries    TicketActivity[] @relation("TicketActivityActor")
  activityFromAssignments TicketActivity[] @relation("TicketActivityFromAssignee")
  activityToAssignments   TicketActivity[] @relation("TicketActivityToAssignee")
  devices      DeviceToken[]
  autoAssigns  AgentAutoAssign[]
  comments     TicketComment[]  @relation("TicketCommentAuthor")
  stepCompletions WorkflowStepCompletion[]
  moreInfoRequestedTickets Ticket[] @relation("TicketMoreInfoRequestedBy")
  moreInfoResolvedTickets  Ticket[] @relation("TicketMoreInfoResolvedBy")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  aiSuggestions AiSuggestion[]
}

model Ticket {
  id          String        @id @default(uuid())
  createdBy   String
  creator     User          @relation("TicketCreator", fields: [createdBy], references: [id])
  assignedTo  String?
  assignee    User?         @relation("TicketAssignee", fields: [assignedTo], references: [id])
  priority    TicketPriority @default(medium)
  issueType   IssueType      @default(other)
  status      TicketStatus   @default(open)
  description String
  attachments String[]
  assignmentRequestId String?
  assignmentRequest   User?    @relation("TicketAssignmentRequests", fields: [assignmentRequestId], references: [id])
  categoryId String?
  category   Category?   @relation(fields: [categoryId], references: [id])
  subcategoryId String?
  subcategory  Subcategory? @relation(fields: [subcategoryId], references: [id])
  slaId      String?
  sla        Sla?        @relation(fields: [slaId], references: [id])
  workflowId String?
  workflow   Workflow?   @relation("TicketWorkflow", fields: [workflowId], references: [id])

  // Workflow cursor (supports moving forward/back while keeping completion history)
  currentWorkflowStepId String?
  currentWorkflowStep   WorkflowStep? @relation("TicketCurrentWorkflowStep", fields: [currentWorkflowStepId], references: [id])

  // More-info flow (keeps the current step active and blocks completion until creator responds)
  moreInfoRequestedAt DateTime?
  moreInfoRequestedBy String?
  moreInfoRequestedByUser User? @relation("TicketMoreInfoRequestedBy", fields: [moreInfoRequestedBy], references: [id])
  moreInfoQuestion String?
  moreInfoStepId String?
  moreInfoStep WorkflowStep? @relation("TicketMoreInfoStep", fields: [moreInfoStepId], references: [id])
  moreInfoCommentId String?
  moreInfoResponseCommentId String?
  moreInfoResolvedAt DateTime?
  moreInfoResolvedBy String?
  moreInfoResolvedByUser User? @relation("TicketMoreInfoResolvedBy", fields: [moreInfoResolvedBy], references: [id])

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  resolvedAt  DateTime?
  activities  TicketActivity[]
  aiSuggestions AiSuggestion[]
  comments    TicketComment[]
  // Dynamic attribute values associated with this ticket
  attributeValues TicketAttributeValue[]
}

model AiSuggestion {
  id           String   @id @default(uuid())
  ticketId     String?
  ticket       Ticket?  @relation(fields: [ticketId], references: [id])
  suggestionType String
  prompt       String
  result       Json
  provider     String?
  providerMeta Json?
  createdBy    String?
  createdByUser User?   @relation(fields: [createdBy], references: [id])
  createdAt    DateTime @default(now())

  @@index([ticketId])
}

model TicketActivity {
  id              String              @id @default(uuid())
  ticketId        String
  ticket          Ticket              @relation(fields: [ticketId], references: [id])
  actorId         String
  actor           User                @relation("TicketActivityActor", fields: [actorId], references: [id])
  type            TicketActivityType
  fromStatus      TicketStatus?
  toStatus        TicketStatus?
  fromAssigneeId  String?
  fromAssignee    User?               @relation("TicketActivityFromAssignee", fields: [fromAssigneeId], references: [id])
  toAssigneeId    String?
  toAssignee      User?               @relation("TicketActivityToAssignee", fields: [toAssigneeId], references: [id])
  comment         String?
  commentId       String?
  stepId          String?
  createdAt       DateTime            @default(now())

  @@index([ticketId])
}

model DeviceToken {
  id          String   @id @default(uuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  deviceToken String
  platform    String
  updatedAt   DateTime  @updatedAt

  @@unique([userId, deviceToken])
}

// Admin-defined attribute metadata
model Attribute {
  id        String   @id @default(uuid())
  key       String   @unique
  label     String
  type      AttributeType
  options   String[]
  required  Boolean  @default(false)
  visibleTo Role[]   @default([])
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  values    TicketAttributeValue[]
}

// Per-ticket attribute values (stored as JSON to support all types)
model TicketAttributeValue {
  id          String    @id @default(uuid())
  ticketId    String
  attributeId String
  value       Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  ticket      Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([ticketId, attributeId])
  @@index([ticketId])
  @@index([attributeId])
}

// Category for ticket classification
model Category {
  id            String   @id @default(uuid())
  name          String   @unique
  description   String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  subcategories Subcategory[]
  tickets       Ticket[]
}

// Subcategory under each category
model Subcategory {
  id          String   @id @default(uuid())
  categoryId  String
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  slas        Sla[]
  tickets     Ticket[]
  autoAssigns AgentAutoAssign[]

  @@unique([categoryId, name])
  @@index([categoryId])
}

// SLA (Service Level Agreement) per category/subcategory
model Sla {
  id              String   @id @default(uuid())
  name            String   @unique
  subcategoryId   String
  responseTimeHours Int
  resolutionTimeHours Int
  priority        TicketPriority
  description     String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  subcategory     Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  tickets         Ticket[]

  @@index([subcategoryId])
}

// Agent auto-assignment rules based on category/subcategory
model AgentAutoAssign {
  id              String   @id @default(uuid())
  subcategoryId   String
  agentId         String
  active          Boolean  @default(true)
  priority        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  subcategory     Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  agent           User     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([subcategoryId, agentId])
  @@index([subcategoryId])
  @@index([agentId])
}

// Workflow for ticket lifecycle management
model Workflow {
  id              String   @id @default(uuid())
  name            String   @unique
  description     String?
  // Workflow can be filtered by role, category, and subcategory
  roleFilter      Role?
  categoryId      String?
  subcategoryId   String?
  isDefault       Boolean  @default(false)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  steps           WorkflowStep[]
  tickets         Ticket[] @relation("TicketWorkflow")
  
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([roleFilter])
  @@index([isDefault])
}

// Individual steps in a workflow
model WorkflowStep {
  id              String   @id @default(uuid())
  workflowId      String
  workflow        Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  order           Int      @default(0)
  // Role required to complete this step. If admin: any admin can complete. If agent: only assigned agent can complete. If user: only creator can complete.
  requiredRole    Role?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  completions     WorkflowStepCompletion[]
  currentForTickets Ticket[] @relation("TicketCurrentWorkflowStep")
  moreInfoForTickets Ticket[] @relation("TicketMoreInfoStep")
  
  @@index([workflowId])
  @@index([order])
}

// Track completion of workflow steps for tickets
model WorkflowStepCompletion {
  id              String       @id @default(uuid())
  ticketId        String
  stepId          String
  step            WorkflowStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  completedBy     String
  completedByUser User         @relation(fields: [completedBy], references: [id])
  comment         String?
  completedAt     DateTime     @default(now())
  
  @@unique([ticketId, stepId])
  @@index([ticketId])
  @@index([stepId])
}

// Comments and replies on tickets
model TicketComment {
  id              String   @id @default(uuid())
  ticketId        String
  ticket          Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId        String
  author          User     @relation("TicketCommentAuthor", fields: [authorId], references: [id])
  content         String
  parentId        String?
  parent          TicketComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies         TicketComment[] @relation("CommentReplies")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([ticketId])
  @@index([parentId])
  @@index([authorId])
}

